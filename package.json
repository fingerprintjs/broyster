{
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @fpjs-incubator/broyster build",
    "lint": "eslint --ext .js,.ts,.html --ignore-path .gitignore --max-warnings 0 node/src node/test example_project",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm --filter @fpjs-incubator/broyster test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
