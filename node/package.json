{
  "name": "@fpjs-incubator/broyster",
  "description": "BrowserStack test tools for Vitest",
  "version": "0.4.0",
  "keywords": [
    "test",
    "tools",
    "vitest",
    "browserstack"
  ],
  "author": "Fingerprint, Inc (https://fingerprint.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/broyster.git"
  },
  "bugs": {
    "url": "https://github.com/fingerprintjs/broyster/issues"
  },
  "homepage": "https://github.com/fingerprintjs/broyster",
  "main": "./node.js",
  "types": "./node.d.ts",
  "exports": {
    ".": {
      "types": "./node.d.ts",
      "default": "./node.js"
    }
  },
  "bin": {
    "broyster-vitest": "./dist/bin/broyster-vitest.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "node.d.ts",
    "node.js"
  ],
  "scripts": {
    "prepack": "cp ../LICENSE LICENSE",
    "build": "rimraf dist && tsc && chmod +x dist/bin/broyster-vitest.js",
    "build:watch": "tsc --watch"
  },
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@types/selenium-webdriver": "^4.1.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser": "^4.1.8",
    "browserstack": "~1.6.1",
    "selenium-webdriver": "^4.7.0",
    "tslib": "^2.4.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^18.11.12",
    "rimraf": "^3.0.2",
    "typescript": "^5.1.6"
  }
}
