{
  "name": "@fpjs-incubator/broyster",
  "description": "Run Vitest browser tests on BrowserStack",
  "version": "1.0.0-beta.0",
  "type": "module",
  "keywords": [
    "test",
    "vitest",
    "browserstack"
  ],
  "author": "Fingerprint, Inc (https://fingerprint.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/broyster.git"
  },
  "bugs": {
    "url": "https://github.com/fingerprintjs/broyster/issues"
  },
  "homepage": "https://github.com/fingerprintjs/broyster",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js"
    },
    "./transports/cloudflare": {
      "types": "./dist/transports/cloudflare.d.ts",
      "import": "./dist/transports/cloudflare.js"
    },
    "./presets/fingerprint": {
      "types": "./dist/presets/fingerprint.d.ts",
      "import": "./dist/presets/fingerprint.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "broyster": "./dist/cli.js"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@types/selenium-webdriver": "4.35.5",
    "@vitest/browser": "4.1.8",
    "cross-spawn": "7.0.6",
    "selenium-webdriver": "4.41.0",
    "tsx": "4.20.6"
  },
  "peerDependencies": {
    "vite": "8.0.13",
    "vitest": "4.1.8"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "rimraf": "6.0.1",
    "vite": "8.0.13",
    "vitest": "4.1.8"
  }
}
