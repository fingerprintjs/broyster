{
  "name": "@fpjs-incubator/broyster",
  "description": "Vitest browser testing tools for local browsers and BrowserStack",
  "version": "1.0.0",
  "keywords": [
    "test",
    "tools",
    "vitest",
    "browserstack",
    "browser"
  ],
  "author": "Fingerprint, Inc (https://fingerprint.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/broyster.git"
  },
  "bugs": {
    "url": "https://github.com/fingerprintjs/broyster/issues"
  },
  "homepage": "https://github.com/fingerprintjs/broyster",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "index.d.ts",
    "index.js",
    "vitest.d.ts",
    "vitest.js"
  ],
  "bin": {
    "broyster-vitest": "./bin/broyster-vitest.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "cp ../LICENSE LICENSE",
    "build": "rimraf dist && tsc",
    "build:watch": "pnpm build --watch"
  },
  "engines": {
    "node": ">= 18"
  },
  "peerDependencies": {
    "@vitejs/plugin-basic-ssl": ">=1",
    "@vitest/browser": ">=4",
    "@vitest/browser-playwright": ">=4",
    "playwright": ">=1.40",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-basic-ssl": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "browserstack": "~1.6.1",
    "browserstack-local": "^1.5.9",
    "selenium-webdriver": "^4.7.0",
    "tslib": "^2.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "playwright": "^1.52.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  }
}
