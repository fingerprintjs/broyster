{
  "name": "@fpjs-incubator/broyster",
  "description": "Cross-browser testing tools: Vitest browser mode on BrowserStack",
  "version": "1.0.0-beta.0",
  "keywords": [
    "test",
    "tools",
    "vitest",
    "browserstack"
  ],
  "author": "Fingerprint, Inc (https://fingerprint.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fingerprintjs/broyster.git"
  },
  "bugs": {
    "url": "https://github.com/fingerprintjs/broyster/issues"
  },
  "homepage": "https://github.com/fingerprintjs/broyster",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "broyster": "./bin/broyster.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepack": "cp ../LICENSE LICENSE",
    "build": "rimraf dist && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/selenium-webdriver": "^4.1.28",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "browserstack-local": "^1.5.9",
    "selenium-webdriver": "^4.41.0"
  },
  "peerDependencies": {
    "@vitest/browser": "^4.1.0",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/browser": "^4.1.5",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
